# ===========================================
# Sentinel AI Engine — Environment Variables
# Copy this file to .env and fill in values.
# Never commit .env to Git.
# ===========================================

# ------------------------------------------
# LLM Configuration
# Required. Get your key from:
# https://aistudio.google.com/app/apikey
# ------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM provider. Currently only "gemini" is supported.
LLM_PROVIDER=gemini

# Model name. Recommended: gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash

# Temperature for LLM responses. 0 = deterministic.
LLM_TEMPERATURE=0

# ------------------------------------------
# Service-to-service auth (required)
# Shared secret expected from Spring Boot via X-Service-Token.
# Must match FASTAPI_SERVICE_TOKEN on the Java side.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------
SENTINEL_INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-secret

# ------------------------------------------
# Per-user rate limits (requests per window)
# ------------------------------------------
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_DOC_PER_MIN=10
RATE_LIMIT_WINDOW_SECONDS=60