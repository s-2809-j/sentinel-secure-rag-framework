# ===========================================
# Sentinel Backend — Environment Variables
# Copy this file to .env and fill in values.
# Never commit .env to Git.
# ===========================================

# ------------------------------------------
# PostgreSQL Database
# ------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# ------------------------------------------
# JWT
# Generate a secret with:
# python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Minimum 32 bytes (256 bits).
# ------------------------------------------
JWT_SECRET=your_base64_jwt_secret_here
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ------------------------------------------
# FastAPI AI Engine
# URL where the Python service is running.
# FASTAPI_SERVICE_TOKEN must match SENTINEL_INTERNAL_SERVICE_TOKEN
# on the Python side (sent as X-Service-Token).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_SERVICE_TOKEN=change-me-to-a-long-random-secret

# ------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins.
# ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000